{
  "name": "core",
  "version": "0.1.0",
  "description": "Telegram to Discord forward bot.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:ts": "node --import=tsx ./src/main.ts",
    "dev": "nodemon --config nodemon.json src/main.ts",
    "dev:debug": "nodemon --config nodemon.json --inspect-brk src/main.ts",
    "lint": "eslint src --no-warn-ignored",
    "clean": "rimraf dist/",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jstarstech/ttdbot"
  },
  "homepage": "https://github.com/jstarstech/ttdbot",
  "bugs": {
    "url": "https://github.com/jstarstech/ttdbot/issues"
  },
  "author": "jstarstech",
  "keywords": [
    "telegram",
    "discord",
    "forward",
    "bot",
    "ttdbot"
  ],
  "license": "MIT",
  "dependencies": {
    "any-shell-escape": "^0.1.1",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fs-extra": "^11.4.1",
    "grammy": "^1.46.0",
    "js-yaml": "^5.4.3",
    "prompts": "^2.4.2",
    "telegram": "^2.26.22",
    "throttled-queue": "^3.0.0",
    "tsx": "^4.23.15",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">= 22.12.0"
  }
}
